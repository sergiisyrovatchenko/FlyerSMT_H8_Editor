<Project>

  <!-- Authorship and version written into every assembly built from this repository (file properties of the exe and dlls) -->
  <PropertyGroup>
    <Product>FlyerSMT H8 Editor</Product>
    <Version>1.0.0</Version>
    <Description>Compares, edits and optimizes FlyerSMT pick-and-place jobs (.H8) side by side</Description>
    <Authors>Sergii Syrovatchenko</Authors>
    <Company>Sergii Syrovatchenko</Company>
    <Copyright>Sergii Syrovatchenko</Copyright>
    <Title>FlyerSMT H8 Editor</Title>
    <!-- "File description" in the file properties -->
    <AssemblyTitle>FlyerSMT H8 Editor</AssemblyTitle>
    <PackageProjectUrl>https://github.com/sergiisyrovatchenko/FlyerSMT_H8_Editor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sergiisyrovatchenko/FlyerSMT_H8_Editor</RepositoryUrl>
  </PropertyGroup>

</Project>
